. Division Operation (÷)","html_id":"id-5-division-operation","implicit":true,"key":"P95wLi2ibL"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Division is performed using the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OmAcIaFWhS"},{"type":"inlineCode","value":"/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UZs0XW1ZaV"},{"type":"text","value":" operator. Integer division uses ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GGyopSWj2c"},{"type":"inlineCode","value":"//","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Sw1yuppXkO"},{"type":"text","value":". Be careful with division by zero.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PsvIbIq6if"}],"key":"WFJM6S9UB7"}],"key":"lyimAFpJsm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Division with integers (float result)\nresult_div = 7 / 2\nprint('7 / 2 =', result_div)\n\n# Integer division\nresult_int_div = 7 // 2\nprint('7 // 2 =', result_int_div)\n\n# Division with floats\nresult_float = 7.5 / 2.5\nprint('7.5 / 2.5 =', result_float)\n\n# Division with NumPy arrays\narr1 = np.array([8, 16, 32])\narr2 = np.array([2, 4, 8])\nresult_arr = arr1 / arr2\nprint('Array division:', result_arr)\n\n# Division by zero example\ntry:\n    print('1 / 0 =', 1 / 0)\nexcept ZeroDivisionError as e:\n    print('Division by zero error:', e)","key":"obEgXjGW9n"},{"type":"outputs","id":"jXbG0kdDDpksySeFzZIbk","children":[],"key":"ecLpwOJm1m"}],"key":"tPAaPGGeaG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Combining Multiple Operations","position":{"start":{"line":1,"column":1},"end":{"