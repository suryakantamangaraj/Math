\nprint('2 + 3 =', result_int)\n\n# Addition with floats\nresult_float = 2.5 + 3.1\nprint('2.5 + 3.1 =', result_float)\n\n# Addition with NumPy arrays\narr1 = np.array([1, 2, 3])\narr2 = np.array([4, 5, 6])\nresult_arr = arr1 + arr2\nprint('Array addition:', result_arr)","key":"GOes1TX5b0"},{"type":"outputs","id":"l93EMbA56seHf6vRUhacc","children":[],"key":"vQhp7jGO3H"}],"key":"CTNgTxXG8b"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Subtraction Operation (−)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LHihzNadEk"}],"identifier":"id-3-subtraction-operation","label":"3. Subtraction Operation (−)","html_id":"id-3-subtraction-operation","implicit":true,"key":"nINKlZboOQ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Subtraction finds the difference between two numbers. Use the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Au7WM55lfZ"},{"type":"inlineCode","value":"-","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WYKJ9qcVIl"},{"type":"text","value":" operator in Python.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VNsYeOavCl"}],"key":"JSietP5bfy"}],"key":"gzSjkB3wNP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Subtraction with integers\nresult_int = 5 - 2\nprint('5 - 2 =', result_int)\n\n# Subtraction with floats\nresult_float = 5.5 - 2.2\nprint('5.5 - 2.2 =', result_float)\n\n# Subtraction with NumPy arrays\narr1 = np.array([10, 20, 30])\narr2 = np.array([1, 2, 3])\nresult_arr = arr1 - arr2\nprint('Array subtraction:', result_arr)","key":"MaIYRSjgX7"},{"type":"outputs","id":"flWXRjqdiOxVxfdhOj1t2","children":[],"key":"ecObRNBlNQ"}],"key":"sCH2N